{
    "name": "lavaphp/http-client",
    "description": "LavaPHP http-client pack — small PSR-18 client on ext-curl with timeouts, bounded retries, and non-2xx as LavaProblems.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "nyholm/psr7": "^1.8",
        "lavaphp/core": "^0.6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "Lava\\HttpClient\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Lava\\HttpClient\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}